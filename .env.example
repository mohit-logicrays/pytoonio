# Environment Variables for Pytoonio Demo Service
# Copy to demo/.env or project root .env and fill in your key.

# ── Groq (inference provider) ────────────────────────────────────────────────
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── LiteLLM Model Selection ──────────────────────────────────────────────────
# Options: groq/llama-3.3-70b-versatile  |  groq/llama3-8b-8192  |  groq/mixtral-8x7b-32768
LITELLM_MODEL=groq/llama-3.3-70b-versatile

# ── FastAPI Service ──────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
